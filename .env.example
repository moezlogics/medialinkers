# Local:  mongodb://127.0.0.1:27017/medialinkers
# Live (MongoDB user with a password, see DEPLOY.md):
#         mongodb://medialinkers:YOUR_DB_PASSWORD@127.0.0.1:27017/medialinkers?authSource=medialinkers
MONGODB_URI=mongodb://127.0.0.1:27017/medialinkers
# Long random string: openssl rand -base64 48
AUTH_SECRET=generate-a-long-random-string
# Must be set BEFORE "npm run build" (it is baked into the build)
NEXT_PUBLIC_SITE_URL=https://www.medialinkers.pk
# First admin account, created by "npm run seed" when no user exists
ADMIN_NAME=Media Linkers Admin
ADMIN_EMAIL=admin@medialinkers.pk
ADMIN_PASSWORD=change-me
